table _calculations
	lineageTag: 2808ed98-d02c-4906-8248-9493d085d871

	measure 'Total Net Sales' = SUM(fct_retail_activity[net_sales_retail])
		lineageTag: 1071a9f6-4610-4925-9b57-9747a81fcf76

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Units' = SUM(fct_retail_activity[net_sales_units])
		lineageTag: 5f161b8e-3cd2-497f-9908-9a4ddc457371

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Inventory Units' = SUM(fct_retail_activity[inventory_units])
		lineageTag: 99348fd3-20e2-4a3b-b1b7-9755ca6ae48c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Unit Price' = DIVIDE([Total Net Sales], [Total Units], 0)
		lineageTag: 2ba8d170-0e8e-40f2-8fb5-b30eeeb16072

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Inventory at Cost' = ```
			
			    SUMX(fct_retail_activity, 
			         fct_retail_activity[inventory_units] * fct_retail_activity[corporate_unit_acquired_cost])
			```
		lineageTag: 44c6c304-e294-4497-8835-afec0d71477d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Inventory at Retail' = ```
			
			    SUMX(fct_retail_activity, 
			         fct_retail_activity[inventory_units] * fct_retail_activity[corporate_unit_owned_retail_price])
			```
		lineageTag: eec50400-c486-46fb-a1f8-f46691413b53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sell-Through Ratio' = DIVIDE([Total Units], [Total Units] + [Total Inventory Units], 0)
		lineageTag: 2a5aebf8-1e59-42a3-8e7c-a9c75a281fec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inventory Overhang' = [Total Inventory Units] - [Total Units]
		lineageTag: 7194e029-e34b-4471-8168-13c700034734

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'WoW Net Sales Change' = ```
			
			    VAR CurrentSales = [Total Net Sales]
			    VAR PrevSales = CALCULATE(
			        [Total Net Sales],
			        DATEADD(fct_retail_activity[period_ending_date], -7, DAY)
			    )
			    RETURN DIVIDE(CurrentSales - PrevSales, PrevSales)
			```
		lineageTag: 81d9c9cc-bb59-4798-8c80-81d95413fc2b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Debug Prev Sales' = ```
			
			    CALCULATE(
			        [Total Net Sales],
			        DATEADD(fct_retail_activity[period_ending_date], -7, DAY)
			    )
			```
		lineageTag: 2aa24300-85cc-44b5-b971-0c6c415b8da3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Store Count' = DISTINCTCOUNT(dim_locations[sps_customer_location_key])
		formatString: 0
		lineageTag: 56d25428-9abd-48ee-9cb4-d29e5890260a

	measure 'Revenue per Store' = DIVIDE([Total Net Sales], [Store Count])
		lineageTag: bfd4656e-fff8-4c73-a576-88d8eedfc4eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of Total Sales' = ```
			
			    DIVIDE(
			        [Total Net Sales],
			        CALCULATE([Total Net Sales], ALL(dim_items[category_name]))
			    )
			```
		lineageTag: d39d0664-c77f-4b39-806d-87ef2d5907c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _calculations = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_ResultType = Table

